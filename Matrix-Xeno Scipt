        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    CreateButton(TargetTab, "❌ Nessun Target (Auto-Closest)", function()
        selectedTargetPlayer = nil
        print("Target impostato su: Più vicino automatico")
    end)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            CreateButton(TargetTab, "👤 " .. player.Name, function()
                selectedTargetPlayer = player
                print("Target selezionato:", player.Name)
            end)
        end
    end
end

Players.PlayerAdded:Connect(RefreshPlayerList)
Players.PlayerRemoving:Connect(RefreshPlayerList)
RefreshPlayerList()

-- Trova il player più vicino se non c'è un target manuale
local function GetClosestPlayer()
    local target = nil
    local shortestDistance = math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local rootPart = player.Character.HumanoidRootPart
            local screenPoint, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
            local mouse = LocalPlayer:GetMouse()
            local distance = (Vector2.new(mouse.X, mouse.Y) - Vector2.new(screenPoint.X, screenPoint.Y)).Magnitude
            if distance < shortestDistance then
                shortestDistance = distance
                target = player.Character
            end
        end
    end
    return target
end

-- Loop Camlock con Prediction
RunService.RenderStepped:Connect(function()
    if camlockMenuEnabled and camlockActive then
        local targetCharacter = nil
        if selectedTargetPlayer and selectedTargetPlayer.Character then
            targetCharacter = selectedTargetPlayer.Character
        else
            targetCharacter = GetClosestPlayer()
        end

        if targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart") and targetCharacter:FindFirstChild("Humanoid") and targetCharacter.Humanoid.Health > 0 then
            local targetPart = targetCharacter.HumanoidRootPart
            local predictedPosition = targetPart.Position + (targetPart.AssemblyLinearVelocity * predictionValue)
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, predictedPosition)
        end
    end
end)

-- Loop ESP Chams
local highlights = {}
local function UpdateESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if espEnabled and player.Character then
                if not highlights[player] then
                    local hl = Instance.new("Highlight")
                    hl.Adornee = player.Character
                    hl.FillColor = Color3.fromRGB(150, 0, 255)
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.FillTransparency = 0.5
                    hl.Parent = player.Character
                    highlights[player] = hl
                end
            else
                if highlights[player] then
                    highlights[player]:Destroy()
                    highlights[player] = nil
                end
            end
        end
    end
end

RunService.RenderStepped:Connect(function()
    if espEnabled then
        UpdateESP()
    end
end)

