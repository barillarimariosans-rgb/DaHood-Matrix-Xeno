-- URL del file JSON su GitHub Raw
local WHITELIST_URL = "https://raw.githubusercontent.com/barillarimariosans-rgb/DaHood-Matrix-Xeno/main/whitelist.json"

local function CheckWhitelist()
    local success, response = pcall(function()
        return game:HttpGet(WHITELIST_URL)
    end)

    if success then
        local ok, data = pcall(function()
            return HttpService:JSONDecode(response)
        end)
        
        if ok and type(data) == "table" then
            for _, id in ipairs(data) do
                if tonumber(id) == LocalPlayer.UserId then
                    return true
                end
            end
        end
    else
        print("⚠️ Whitelist bypassata per test locale o errore di connessione.")
        return true
    end
    return false
end

if not CheckWhitelist() then
    warn("❌ Accesso negato: ID non in whitelist.")
    return
end

