-- LOGICA DI FUNZIONAMENTO INTELLIGENTE BYPASS
-- ==========================================================

local function TrovaNemicoVicino()
    local piuVicino, distanzaMinima = nil, math.huge
    local localChar = LocalPlayer.Character
    if not localChar or not localChar:FindFirstChild("HumanoidRootPart") then return nil end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
            local dist = (localChar.HumanoidRootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
            if dist < distanzaMinima then piuVicino, distanzaMinima = p, dist end
        end
    end
    return piuVicino
end

UserInputService.InputBegan:Connect(function(input, inChat)
    if inChat then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    if input.KeyCode == Enum.KeyCode.P then MainFrame.Visible = not MainFrame.Visible return end

    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    if input.KeyCode == Config.Tasti.Velocita then
        velocitaAttiva = not velocitaAttiva
    end
    if input.KeyCode == Config.Tasti.Aimlock then
        aimlockAttivo = not aimlockAttivo; targetNemico = aimlockAttivo and TrovaNemicoVicino() or nil
    end
    if input.KeyCode == Config.Tasti.Volo then
        voloAttivo = not voloAttivo
        if voloAttivo then
            forzaVolo = Instance.new("BodyVelocity", char.HumanoidRootPart); forzaVolo.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        else
            if forzaVolo then forzaVolo:Destroy() end
        end
    end
    if input.KeyCode == Config.Tasti.NoClip then noclipAttivo = not noclipAttivo end
    if input.KeyCode == Config.Tasti.Teleport then
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") and (v.Name:lower():match("ammo") or v.Name:lower():match("gunshop")) then
                char.HumanoidRootPart.CFrame = v.CFrame + Vector3.new(0, 3, 0) break
            end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then return end

    -- Bypass Corsa (Spinta vettoriale fluida per non farsi laggare o cacciare dall'anti-cheat)
    if velocitaAttiva and char.Humanoid.MoveDirection.Magnitude > 0 then
        char.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame + (char.Humanoid.MoveDirection * (Config.ValoreVelocita / 100))
    end

    -- Chiusura della riga troncata e logica Camlock corretta
    if aimlockAttivo and targetNemico and targetNemico.Character and targetNemico.Character:FindFirstChild(Config.MiraTarget) then
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetNemico.Character[Config.MiraTarget].Position)
    end

    -- Logica Volo Vettoriale
    if voloAttivo and forzaVolo and char:FindFirstChild("HumanoidRootPart") then
        local cam, dir = Camera.CFrame, Vector3.new(0,0,0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.RightVector end
        forzaVolo.Velocity = dir * Config.ValoreVolo
    end

    -- Logica NoClip Selettiva
    if noclipAttivo then
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Name ~= "Torso" and part.Name ~= "LowerTorso" then 
                part.CanCollide = false 
            end
        end
    end
end)
